{
  "name": "homelab-nexus",
  "version": "1.0.23",
  "description": "Unified homelab dashboard aggregating Beszel, Uptime Kuma, Gotify and OPNsense",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^8.57.0",
    "jsdom": "^30.1.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
