# ---------------------------------------------------------------------------
# Configuracion NO secreta del dashboard.
# Los secretos van separados: claves/API keys/tokens (ver secrets.example/).
# IMPORTANTE: cada servicio solo se muestra si su URL esta definida. OPNsense
# sigue en desarrollo y se puede omitir por completo.
# ---------------------------------------------------------------------------

# Puerto interno del contenedor / servidor
PORT=3000

# Host y puerto a los que se enlaza el servidor
HOST=0.0.0.0

# Intervalo de polling de los servicios (en milisegundos)
POLL_INTERVAL_MS=5000

# ---------------------------------------------------------------------------
# URLs base de los servicios (opcionales: tambien pueden ir como Docker secrets).
# Si se definen aqui, no hace falta el secret equivalente.
# ---------------------------------------------------------------------------

#BESZEL_URL=http://beszel.example.local:8090
#UPTIMEKUMA_URL=http://uptime-kuma.example.local:3001
#GOTIFY_URL=http://gotify.example.local:8081
#OPNSENSE_URL=https://opnsense.example.local   # integracion experimental

# ---------------------------------------------------------------------------
# Credenciales/secretos opcionales como env (alternativa a Docker secrets).
# ---------------------------------------------------------------------------

# Beszel: login de un usuario (para la API de PocketBase)
#BESZEL_USER_EMAIL=tu_email@dominio
#BESZEL_USER_PASSWORD=tu_password

# Uptime Kuma: slug de la status page publica
#UPTIMEKUMA_STATUS_PAGE=mi-slug

# Gotify: token de un cliente de mensajes
#GOTIFY_TOKEN=A.Tu.token

# OPNsense (pendiente)
#OPNSENSE_API_KEY=
#OPNSENSE_API_SECRET=
